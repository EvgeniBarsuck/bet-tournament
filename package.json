{
  "name": "bet-tournament",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "producer": "node --env-file-if-exists=.env dist/scripts/producer.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test dist/test/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 dist/test/integration/*.test.js",
    "test:smoke": "node --env-file-if-exists=.env dist/scripts/smoke.js",
    "check": "prettier --check . && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/microservices": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
